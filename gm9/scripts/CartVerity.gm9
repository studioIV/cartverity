# SPDX-License-Identifier: MIT
# CartVerity v0.1.0 - targets official GodMode9 v2.2.3.
# Reads cartridge ROM/reference data. Writes ONLY SD logs.
# This checks GM9's virtual ROM view; cached regions are not reread.

set ERRORMSG "Check stopped. SD log may be incomplete."
set SUCCESSMSG "Run ended. Read the result; completion is not a pass."
if not ask "CartVerity v0.1.0\nKeep the DS cart inserted.\nTwo SHA-1 passes of the ROM view.\nOnly SD logs will be written."
    set SUCCESSMSG "Cancelled before starting."
    goto done
end

# Fail closed if a log directory cannot be created.
set ERRORMSG "Cannot create/write SD log. Check SD and free space."
if not isdir 0:/gm9/out
    mkdir 0:/gm9/out
end
if not isdir 0:/gm9/out/dscheck
    mkdir 0:/gm9/out/dscheck
end
set STARTED "$[DATESTAMP]_$[TIMESTAMP]"
findnot 0:/gm9/out/dscheck/$[STARTED]_????.txt LOG
dumptxt $[LOG] "format=ds-cart-check/1"
dumptxt -p $[LOG] "state=INCOMPLETE"
dumptxt -p $[LOG] "script_version=0.1.0"
dumptxt -p $[LOG] "gm9_version=$[GM9VER]"
dumptxt -p $[LOG] "console_type=$[ONTYPE]"
dumptxt -p $[LOG] "started=$[STARTED]"
dumptxt -p $[LOG] "view=full_standard_nds"
dumptxt -p $[LOG] "algorithm=SHA1"
dumptxt -p $[LOG] "scope=GM9_virtual_ROM_including_cached_regions"
set ERRORMSG "Check stopped. Log may be incomplete:\n$[LOG]"
set READ_RESULT NOT_STARTED
set REF_RESULT NOT_PROVIDED
set RESULT NOT_STARTED
set EXPECTED ""

# The cart-info name has the exact cartridge stem. Strip only its last
# extension: real titles can contain dots. Never hash a trimmed sibling.
if not find -f C:/*.txt CARTINFO
    set RESULT NO_DS_ROM
    goto finish
end
strsplit -b BASE $[CARTINFO] "."
set ROM $[BASE].nds
if not exist $[ROM]
    set RESULT FULL_ROM_UNAVAILABLE
    goto finish
end
strsplit NAME $[ROM] "/"
dumptxt -p $[LOG] "rom=$[ROM]"

# Offsets/sizes are hexadecimal. Header bytes identify the view,
# but a readable header alone does not prove cartridge integrity.
if not fget $[ROM]@C:4 GAMECODE
    set RESULT HEADER_READ_FAILED
    goto finish
end
if not fget $[ROM]@1E:1 REVISION
    set RESULT HEADER_READ_FAILED
    goto finish
end
dumptxt -p $[LOG] "game_code_hex=$[GAMECODE]"
dumptxt -p $[LOG] "revision_hex=$[REVISION]"

# Optional reference is exactly 20 binary bytes, made by the PC helper.
# Never use a saved observation as a known-good reference automatically.
set REF 0:/gm9/support/dscheck/$[NAME].sha1
dumptxt -p $[LOG] "reference_path=$[REF]"
if exist $[REF]
    set REF_RESULT INVALID_OR_UNREADABLE
    if fget $[REF]@0:14 EXPECTED
        if fget $[REF]@14:1 EXTRA
            set EXPECTED ""
        else
            set REF_RESULT LOADED
            dumptxt -p $[LOG] "reference_sha1=$[EXPECTED]"
        end
    end
end

echo "ROM: $[NAME]\nPass 1 of 2; allow several minutes.\nKeep the cartridge inserted."
# Explicit @0 makes the parser use this suffix, preserving title @ signs.
if not shaget --sha1 $[ROM]@0 HASH1
    set READ_RESULT PASS1_FAILED_OR_CANCELLED
    set RESULT READ_INCOMPLETE
    goto finish
end
dumptxt -p $[LOG] "sha1_pass1=$[HASH1]"
echo "Pass 2 of 2; keep the cart inserted.\nSome ROM regions are cached by GM9."
if not shaget --sha1 $[ROM]@0 HASH2
    set READ_RESULT PASS2_FAILED_OR_CANCELLED
    set RESULT READ_INCOMPLETE
    goto finish
end
dumptxt -p $[LOG] "sha1_pass2=$[HASH2]"
if not chk $[HASH1] $[HASH2]
    set READ_RESULT INCONSISTENT
    set RESULT INCONSISTENT_READS
    goto finish
end

set READ_RESULT CONSISTENT
set RESULT CONSISTENT_UNVERIFIED
if chk $[REF_RESULT] LOADED
    if chk $[HASH1] $[EXPECTED]
        set REF_RESULT MATCH
        set RESULT MATCHES_SUPPLIED_REFERENCE
    else
        set REF_RESULT MISMATCH
        set RESULT REFERENCE_MISMATCH
    end
end

@finish
# Write completion last. An interrupted run keeps state=INCOMPLETE.
dumptxt -p $[LOG] "read_result=$[READ_RESULT]"
dumptxt -p $[LOG] "reference_result=$[REF_RESULT]"
dumptxt -p $[LOG] "result=$[RESULT]"
dumptxt -p $[LOG] "finished=$[DATESTAMP]_$[TIMESTAMP]"
dumptxt -p $[LOG] "state=COMPLETE"
echo "Result: $[RESULT]\nReference: $[REF_RESULT]\nLog: $[LOG]"
# Viewing is optional: exiting the viewer must not invalidate the log.
textview -o -s $[LOG]

@done
